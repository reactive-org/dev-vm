[terminal]
vt = 7

[default_session]
{% if desktop_session == "i3-x11" %}
command = "agreety --cmd /usr/bin/startx {{ workstation_home }}/.xinitrc -- :0 vt7 -keeptty -nolisten tcp"
{% elif hyprland_use_legacy_drm | bool %}
command = "agreety --cmd /usr/bin/env AQ_NO_ATOMIC=1 /usr/bin/start-hyprland"
{% else %}
command = "agreety --cmd /usr/bin/start-hyprland"
{% endif %}
user = "_greetd"
