[Unit]
Description=Parallels shared clipboard for Wayland
ConditionFileIsExecutable=/usr/bin/prlcp
Conflicts=parallels-prlcp-x11.service

[Service]
Type=simple
Environment=GDK_BACKEND=wayland
ExecStart=/usr/bin/prlcp
Restart=always
RestartSec=1
RuntimeMaxSec={{ parallels_clipboard_restart_interval }}
