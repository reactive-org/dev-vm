set $mainMod Mod1+Mod4
font pango:{{ ui_font_family }} {{ ui_font_size }}

floating_modifier $mainMod
focus_follows_mouse yes
default_border pixel 2
default_floating_border pixel 2
gaps inner 4
gaps outer 8

exec_always --no-startup-id setxkbmap {{ keyboard_layout }}
exec --no-startup-id dunst
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
{% if install_1password | bool and onepassword_start_in_background | bool %}
exec --no-startup-id /opt/1Password/1password --silent
{% endif %}

# Applications
bindsym $mainMod+Return exec --no-startup-id {{ workstation_home }}/.local/bin/kitty
bindsym $mainMod+space exec --no-startup-id rofi -show drun
bindsym $mainMod+b exec --no-startup-id google-chrome-stable
bindsym $mainMod+Shift+b exec --no-startup-id firefox
bindsym $mainMod+c exec --no-startup-id code
bindsym $mainMod+e exec --no-startup-id nautilus

# Windows
bindsym $mainMod+q kill
bindsym $mainMod+f fullscreen toggle
bindsym $mainMod+v floating toggle
bindsym $mainMod+Shift+r restart

# Session
bindsym $mainMod+l exec --no-startup-id i3lock -c 111111

# Screenshots
bindsym $mainMod+Shift+s exec --no-startup-id flameshot gui

# Focus
bindsym $mainMod+Left focus left
bindsym $mainMod+Right focus right
bindsym $mainMod+Up focus up
bindsym $mainMod+Down focus down

# Move windows
bindsym $mainMod+Shift+Left move left
bindsym $mainMod+Shift+Right move right
bindsym $mainMod+Shift+Up move up
bindsym $mainMod+Shift+Down move down

{% for workspace in range(1, 10) %}
set $ws{{ workspace }} "{{ workspace }}"
bindsym $mainMod+{{ workspace }} workspace number $ws{{ workspace }}
bindsym $mainMod+Shift+{{ workspace }} move container to workspace number $ws{{ workspace }}
{% endfor %}

# Audio
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

bar {
    position top
    status_command i3status
    font pango:{{ ui_font_family }} {{ ui_font_size }}
    tray_output primary
}
{% if i3_extra_config | length > 0 %}

# Checkout-specific overrides
{% for directive in i3_extra_config %}
{{ directive }}
{% endfor %}
{% endif %}
