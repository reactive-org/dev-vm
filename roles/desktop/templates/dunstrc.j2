[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 120
    origin = top-right
    offset = 12x12
    notification_limit = 5
    font = {{ ui_font_family }} {{ ui_font_size }}
    frame_width = 1
    frame_color = "#666666"
    separator_color = frame
    corner_radius = 6

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#3b1f2b"
    foreground = "#ffffff"
    frame_color = "#f38ba8"
    timeout = 0
