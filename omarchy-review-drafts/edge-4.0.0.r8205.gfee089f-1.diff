+  case ${vendor,,} in *"to be filled"* | *"system manufacturer"* | *"default string"* | *"not applicable"*) vendor="" ;; esac
+  case ${model,,} in *"to be filled"* | *"system product name"* | *"default string"* | *"not applicable"*) model="" ;; esac
