+    elif ((status == OMARCHY_FORM_BACK)); then
+      break
+    elif ((status == OMARCHY_FORM_SIGNAL)); then
+      confirm_reboot && exec systemctl reboot
+    else
+      confirm_shutdown && exec systemctl poweroff
+    fi
+  done
+  trap - INT
+  printf '\033[H\033[2J'
+  fit_console_font
+  return "$status"
