+
+eula_form() {
+  local status
+  [[ -n $OMARCHY_OEM_EULA ]] || return 0
+
+  # Setup ends as it opened, under the brand.
+  printf '\033[H\033[2J'
+  brand_console_font
+  local LOGO_PATH=$BRAND_LOGO_PATH LOGO_HEIGHT=$BRAND_LOGO_HEIGHT LOGO_COLOR=$BRAND_LOGO_COLOR
+
+  # The agreement reads its own keys, so there Ctrl+C is a signal, and one
+  # that lands while the screen after it is drawn must not end setup.
+  trap : INT
+  while true; do
+    omarchy_oem_eula && status=0 || status=$?
+    if ((status == 0)); then
