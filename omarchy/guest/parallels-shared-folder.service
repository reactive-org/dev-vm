[Unit]
Description=Parallels host shared folder at /mnt/shared
Requires=prltoolsd.service
After=prltoolsd.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStart=/usr/bin/prl_fsd /mnt/shared -f -onosuid,nodev,noatime,fsname=Shared,subtype=prl_fsd --share --sf=Shared
ExecStop=/usr/bin/fusermount -u /mnt/shared
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
