#!/usr/bin/env bash

set -euo pipefail

state_dir="${HOME}/.local/state/dev-vm"
output="${state_dir}/session-check.txt"
temporary="${output}.tmp"

mkdir -p "$state_dir"
sleep 12
{
  date -u '+checked_at=%Y-%m-%dT%H:%M:%SZ'
  printf '%s\n' '--- monitors ---'
  hyprctl monitors all
  printf '%s\n' '--- renderer ---'
  glxinfo -B
  printf '%s\n' '--- config errors ---'
  hyprctl configerrors
} > "$temporary" 2>&1
mv "$temporary" "$output"
